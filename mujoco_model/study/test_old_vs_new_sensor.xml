<mujoco model="test_old_vs_new_sensor">
  <compiler angle="degree" meshdir="meshes/"/>
  <option timestep="0.001" gravity="0 0 -9.81"/>
  <asset>
    <mesh name="radar_dome_mesh"      file="radar_dome.stl"      scale="1 1 1"/>
    <mesh name="sonar_sensor_mesh"    file="sonar_sensor.stl"    scale="1 1 1"/>
    <mesh name="distance_sensor_mesh" file="distance_sensor.stl" scale="1 1 1"/>
  </asset>
  <worldbody>
    <light name="light_top" pos="0 0 1.0" dir="0 0 -1" diffuse="0.8 0.8 0.8" directional="true"/>
    <geom name="floor" type="plane" size="1 1 0.01" rgba="0.6 0.6 0.6 1"/>

    <!-- bevel_gear_36相当: ワールド原点・無回転 -->
    <body name="gear36_dummy" pos="0 0 0.05" euler="0 0 0">
      <body name="radar_dome" pos="0 0 0" euler="0 0 0">
        <geom name="dome_geom" type="mesh" mesh="radar_dome_mesh"
              contype="0" conaffinity="0" rgba="0.2 0.5 0.2 0.25"/>

        <!-- 旧インライン版（緑） -->
        <body name="sonar_sensor_old" pos="0.0010 -0.0093 0.0227" euler="0 0 180">
          <geom name="sonar_geom_old" type="mesh" mesh="sonar_sensor_mesh"
                contype="0" conaffinity="0" rgba="0.2 0.9 0.2 0.6"/>
          <site name="old_site" pos="0 0.012 0" size="0.004" rgba="0 1 0 1"/>
        </body>

        <!-- 新include版（赤） -->
        <body name="sonar_sensor_new" pos="0.0019 -0.0193 0.0223" euler="0 0 180">
          <include file="../sim/libspikehat_sim/examples/components/distance_sensor_body.xml"/>
        </body>
      </body>
    </body>
  </worldbody>
</mujoco>
